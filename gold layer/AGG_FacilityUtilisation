CREATE OR REPLACE VIEW GOLD.AGG_FACILITYUTILISATION AS
SELECT
    f.FACILITY_NAME,
    f.STATE,
    d.YEAR,
    d.MONTH,
    AVG(c.OCCUPANCY_RATE) AS OCCUPANCY_RATE
FROM SILVER.FACT_CAPACITY c
JOIN SILVER.DIM_FACILITY f
ON c.FACILITY_ID=f.FACILITY_ID
JOIN SILVER.DIM_DATE d
ON c.DATE_KEY=d.DATE_KEY
GROUP BY
f.FACILITY_NAME,
f.STATE,
d.YEAR,
d.MONTH
HAVING AVG(c.OCCUPANCY_RATE)>85;

select * from GOLD.AGG_FACILITYUTILISATION;
