CREATE OR REPLACE VIEW GOLD.AGG_CLAIMSBYDIAGNOSIS AS
SELECT
    d.ICD10_CHAPTER,
    d.SEVERITY_TIER,
    dt.YEAR,
    dt.MONTH,
    COUNT(*) AS CLAIM_COUNT,
    SUM(c.PAID_AMOUNT) AS TOTAL_PAID
FROM SILVER.FACT_CLAIMS c
JOIN SILVER.DIM_DIAGNOSIS d
ON c.DIAGNOSIS_ID = d.DIAGNOSIS_ID
JOIN SILVER.DIM_DATE dt
ON c.DATE_KEY = dt.DATE_KEY
GROUP BY
d.ICD10_CHAPTER,
d.SEVERITY_TIER,
dt.YEAR,
dt.MONTH;

select * from GOLD.AGG_CLAIMSBYDIAGNOSIS;
