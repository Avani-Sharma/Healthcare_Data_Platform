CREATE OR REPLACE VIEW GOLD.RPT_COSTPERDISCHARGE AS
SELECT
    f.FACILITY_NAME,
    f.STATE,
    d.YEAR,
    AVG(c.NET_REVENUE) AS AVG_REVENUE_PER_DISCHARGE
FROM SILVER.FACT_CLAIMS c
JOIN SILVER.DIM_FACILITY f
ON c.FACILITY_ID=f.FACILITY_ID
JOIN SILVER.DIM_DATE d
ON c.DATE_KEY=d.DATE_KEY
GROUP BY
f.FACILITY_NAME,
f.STATE,
d.YEAR;

select * from GOLD.RPT_COSTPERDISCHARGE;
