CREATE OR REPLACE VIEW GOLD.RPT_PATIENTPOPULATION AS
SELECT
    p.AGE_BAND,
    p.GENDER,
    p.INSURANCE_TIER,
    COUNT(DISTINCT p.PATIENT_ID) AS TOTAL_PATIENTS
FROM SILVER.DIM_PATIENT p
JOIN SILVER.FACT_CLAIMS c
ON p.PATIENT_ID=c.PATIENT_ID
GROUP BY
p.AGE_BAND,
p.GENDER,
p.INSURANCE_TIER;

select * from GOLD.RPT_PATIENTPOPULATION;
